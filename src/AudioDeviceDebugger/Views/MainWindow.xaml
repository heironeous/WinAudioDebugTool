<Window x:Class="AudioDeviceDebugger.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AudioDeviceDebugger.Views"
        Title="Audio Device Debugger" Height="800" Width="1200" MinWidth="900" MinHeight="500"
        Background="#2D2D30">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: actions + selected device on the first line, list filters on the second. -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click" Padding="12,4" Margin="0,0,8,0"/>
                <Border Width="1" Background="#555" Margin="0,2,8,2"/>
                <Button Content="Set Default" Click="SetDefaultButton_Click" Padding="12,4" Margin="0,0,4,0"
                        IsEnabled="{Binding CanSetDefaults}" ToolTipService.ShowOnDisabled="True"
                        ToolTip="Make the selected device the default device (Console + Multimedia roles)"/>
                <Button Content="Set Comms" Click="SetCommsButton_Click" Padding="12,4" Margin="0,0,4,0"
                        IsEnabled="{Binding CanSetDefaults}" ToolTipService.ShowOnDisabled="True"
                        ToolTip="Make the selected device the default communications device"/>
                <Button Content="Set Both" Click="SetBothButton_Click" Padding="12,4" Margin="0,0,8,0"
                        IsEnabled="{Binding CanSetDefaults}" ToolTipService.ShowOnDisabled="True"
                        ToolTip="Make the selected device both the default and the default communications device"/>
                <TextBlock VerticalAlignment="Center" Foreground="Gray">
                    <Run Text="Selected:"/>
                    <Run Text="{Binding SelectedDevice.Device.FriendlyName, Mode=OneWay, FallbackValue='(none)'}" Foreground="White"/>
                    <Run Text="{Binding SelectedDevice.StateText, Mode=OneWay, StringFormat='({0})', FallbackValue=''}"/>
                </TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Show:" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <CheckBox IsChecked="{Binding ShowDisabledDevices}" VerticalAlignment="Center" Margin="0,0,10,0"
                          Foreground="White"
                          ToolTip="Show endpoints disabled in Windows Sound settings">
                    <TextBlock>
                        <Run Text="Disabled"/>
                        <Run Text="{Binding DisabledDeviceCount, Mode=OneWay, StringFormat='({0})'}" Foreground="Gray"/>
                    </TextBlock>
                </CheckBox>
                <CheckBox IsChecked="{Binding ShowNotPresentDevices}" VerticalAlignment="Center" Margin="0,0,10,0"
                          Foreground="White"
                          ToolTip="Show endpoints whose hardware isn't connected (e.g. headsets that were used once)">
                    <TextBlock>
                        <Run Text="Not present"/>
                        <Run Text="{Binding NotPresentDeviceCount, Mode=OneWay, StringFormat='({0})'}" Foreground="Gray"/>
                    </TextBlock>
                </CheckBox>
                <CheckBox IsChecked="{Binding ShowUnpluggedDevices}" VerticalAlignment="Center" Margin="0,0,12,0"
                          Foreground="White"
                          ToolTip="Show endpoints whose hardware is present but has nothing plugged into the jack">
                    <TextBlock>
                        <Run Text="Unplugged"/>
                        <Run Text="{Binding UnpluggedDeviceCount, Mode=OneWay, StringFormat='({0})'}" Foreground="Gray"/>
                    </TextBlock>
                </CheckBox>
            </StackPanel>
        </StackPanel>

        <!-- Device list on top, selected device's details below; drag the splitter between them to resize. -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="200"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="DeviceGrid"
                      Grid.Row="0"
                      ItemsSource="{Binding Devices}"
                      SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      Margin="0,0,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Dir" Binding="{Binding DirectionText}" Width="55"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Device.FriendlyName}" Width="*" MinWidth="200"/>
                    <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="80"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding DefaultBadge}" Width="95"/>
                    <DataGridTemplateColumn Header="Level (dB)" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding MeterLevel, Mode=OneWay}" ToolTip="{Binding LevelText}"
                                             Height="14" Foreground="#00E676"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- UpdateSourceTrigger=PropertyChanged is required: inside a DataGrid, cell bindings join the row's
                         BindingGroup, which makes their default trigger Explicit (only on row edit commit), so
                         without it the slider/toggle never write back to the view model. -->
                    <DataGridTemplateColumn Header="Volume" Width="190">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Visibility="{Binding HasVolume, Converter={StaticResource BoolToVisibility}}" Margin="2,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" IsChecked="{Binding IsMuted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Width="26" Height="22" Margin="0,0,4,0" Padding="0">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="ToolTip" Value="Mute"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                        <Setter Property="ToolTip" Value="Unmute"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <!-- Output: speaker / speaker-muted. Input: mic / mic-off. -->
                                                    <Setter Property="Text" Value="&#xE720;"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOutput}" Value="True">
                                                            <Setter Property="Text" Value="&#xE767;"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsOutput}" Value="True"/>
                                                                <Condition Binding="{Binding IsMuted}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Text" Value="&#xE74F;"/>
                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsOutput}" Value="False"/>
                                                                <Condition Binding="{Binding IsMuted}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Text" Value="&#xEC54;"/>
                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </ToggleButton>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                            Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10"/>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Text="{Binding VolumePercent, StringFormat={}{0:0}%}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Test" Width="96">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Click="TestButton_Click" Margin="2" Padding="6,2" MinWidth="86">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="ToolTip" Value="Start test"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTesting}" Value="True">
                                                        <Setter Property="ToolTip" Value="Stop test"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Test"/>
                                                        <Style.Triggers>
                                                            <!-- Input test, 2nd phase: the recording is being played back. -->
                                                            <DataTrigger Binding="{Binding IsPlayingBack}" Value="True">
                                                                <Setter Property="Text" Value="Playback"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" FontSize="11"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE768;"/>
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTesting}" Value="True">
                                                                <Setter Property="Text" Value="&#xE71A;"/>
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                          Cursor="SizeNS" ToolTip="Drag to resize the device list / details"/>

            <!-- Details: device info, level graph and channel meters on the left; collapsible property table on the
                 right (column widths / visibility are switched in code-behind, see ApplyPropertiesPanelLayout). -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="320"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="PropertiesColumn" Width="3*" MinWidth="400"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="60"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="{Binding SelectedDevice.Device.FriendlyName}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding SelectedDevice.Device.Id}" FontSize="10" Foreground="Gray" TextWrapping="Wrap"/>
                        <TextBlock Foreground="White" Margin="0,4,0,0">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="Shared mode: {0}&#x0a;Exclusive mode: {1}">
                                    <Binding Path="SelectedDeviceDetails.SharedModeFormat" TargetNullValue="n/a (device not active)" FallbackValue="…"/>
                                    <Binding Path="SelectedDeviceDetails.ExclusiveModeFormat" TargetNullValue="n/a" FallbackValue="…"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    <local:LevelGraph x:Name="DetailGraph" Grid.Row="1" Margin="0,0,0,8"/>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding SelectedDeviceChannelPeaks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" Width="32" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding ChannelLabel}" FontSize="9" Foreground="Gray" HorizontalAlignment="Center"/>
                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding MeterLevel, Mode=OneWay}" ToolTip="{Binding LevelText}"
                                                 Orientation="Vertical" Width="24" Height="48" Foreground="#00E676"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <GridSplitter x:Name="PropertiesSplitter" Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="Transparent" ResizeBehavior="PreviousAndNext" ShowsPreview="False"/>

                <ListView x:Name="PropertiesList" Grid.Column="2" ItemsSource="{Binding SelectedDeviceProperties}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Property" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Unknown keys show their raw UID, greyed so named ones stand out. -->
                                        <TextBlock Text="{Binding Name}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="ToolTip" Value="{Binding Symbol}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsKnown}" Value="False">
                                                            <Setter Property="Foreground" Value="Gray"/>
                                                            <Setter Property="ToolTip" Value="Not in the property-key name table"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Value" DisplayMemberBinding="{Binding Value}" Width="320"/>
                            <GridViewColumn Header="Key" Width="330">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="Gray">
                                            <Run Text="{Binding Symbol, Mode=OneWay}"/>
                                            <Run Text="{Binding RawKey, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Collapse/expand strip for the property table. -->
                <ToggleButton Grid.Column="3" Width="26" Margin="4,0,0,0" Padding="0"
                              VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                              IsChecked="{Binding IsPropertiesPanelOpen}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="ToolTip" Value="Show device properties"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPropertiesPanelOpen}" Value="True">
                                    <Setter Property="ToolTip" Value="Hide device properties"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <!-- Closed: chevron-left ("expand to the left"); open: chevron-right ("collapse"). -->
                                    <Setter Property="Text" Value="&#xE76B;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPropertiesPanelOpen}" Value="True">
                                            <Setter Property="Text" Value="&#xE76C;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Properties" Margin="0,8,0,0" HorizontalAlignment="Center">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="90"/>
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </StackPanel>
                </ToggleButton>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Margin="0,8,0,0" Padding="6" Background="#1E1E1E">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White"/>
        </Border>
    </Grid>
</Window>
