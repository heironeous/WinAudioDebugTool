<Window x:Class="AudioDeviceDebugger.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AudioDeviceDebugger.Views"
        Title="Audio Device Debugger" Height="800" Width="1200" MinWidth="900" MinHeight="500"
        Background="{DynamicResource SurfaceBase}" FontSize="{StaticResource FontLabel}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- A device's role pills (its data context is a DeviceRowViewModel, or null while nothing is selected). -->
        <DataTemplate x:Key="RoleBadges">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource Badge}"
                        ToolTip="Default device: what music, videos and most apps use"
                        Visibility="{Binding Device.IsDefaultDevice, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <TextBlock Text="Default" Style="{StaticResource BadgeText}"/>
                </Border>
                <Border Style="{StaticResource Badge}"
                        ToolTip="Default communications device: what call apps (Teams, Webex…) use"
                        Visibility="{Binding Device.IsDefaultCommunicationsDevice, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    <TextBlock Text="Comms" Style="{StaticResource BadgeText}"/>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="12,4,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: actions on the left, list filters on the right. -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
            <Button x:Name="RefreshButton" Click="RefreshButton_Click" Style="{StaticResource FlatButton}" Padding="12,5" Margin="0,0,8,0"
                    AutomationProperties.Name="Refresh" ToolTip="Read the device list again">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontLabel}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Border Width="1" Background="{DynamicResource BorderSubtle}" Margin="0,4,8,4"/>
            <Button Content="Set Default" Click="SetDefaultButton_Click" Style="{StaticResource FlatButton}" Padding="14,5" Margin="0,0,8,0"
                    IsEnabled="{Binding CanSetDefaults}" ToolTipService.ShowOnDisabled="True"
                    ToolTip="Make the selected device the default device (Console + Multimedia roles)"/>
            <Button Content="Set Comms" Click="SetCommsButton_Click" Style="{StaticResource FlatButton}" Padding="14,5" Margin="0,0,8,0"
                    IsEnabled="{Binding CanSetDefaults}" ToolTipService.ShowOnDisabled="True"
                    ToolTip="Make the selected device the default communications device"/>
            <Button Content="Set Both" Click="SetBothButton_Click" Style="{StaticResource FlatButton}" Padding="14,5" Margin="0,0,8,0"
                    IsEnabled="{Binding CanSetDefaults}" ToolTipService.ShowOnDisabled="True"
                    ToolTip="Make the selected device both the default and the default communications device"/>
            <!-- Bluetooth Connect / Disconnect, like the Windows Sound settings; only for Bluetooth-paired devices. -->
            <Border Width="1" Background="{DynamicResource BorderSubtle}" Margin="0,4,8,4"/>
            <Button Click="BluetoothButton_Click" Style="{StaticResource FlatButton}" Padding="12,5" Margin="0,0,8,0"
                    IsEnabled="{Binding CanToggleBluetoothConnection}" ToolTipService.ShowOnDisabled="True"
                    ToolTip="{Binding BluetoothButtonToolTip}" AutomationProperties.Name="{Binding BluetoothButtonText}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE702;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontLabel}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding BluetoothButtonText}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <!-- Disable / Enable the selected endpoint, like the Windows Sound settings (any device type). -->
            <Button Click="EnableButton_Click" Style="{StaticResource FlatButton}" Padding="12,5"
                    IsEnabled="{Binding CanToggleEndpointEnabled}" ToolTipService.ShowOnDisabled="True"
                    ToolTip="{Binding EnableButtonToolTip}" AutomationProperties.Name="{Binding EnableButtonText}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding EnableButtonGlyph}" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontLabel}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding EnableButtonText}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Also show" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" Margin="8,0,8,0"/>
                <CheckBox IsChecked="{Binding ShowUnpluggedDevices}" Style="{StaticResource FilterChip}" VerticalAlignment="Center" Margin="0,0,8,0"
                          AutomationProperties.Name="Unplugged"
                          ToolTip="Show endpoints whose hardware is present but has nothing plugged into the jack">
                    <TextBlock>
                        <Run Text="Unplugged"/>
                        <Run Text="{Binding UnpluggedDeviceCount, Mode=OneWay}" Foreground="{DynamicResource TextTertiary}"/>
                    </TextBlock>
                </CheckBox>
                <CheckBox IsChecked="{Binding ShowDisabledDevices}" Style="{StaticResource FilterChip}" VerticalAlignment="Center" Margin="0,0,8,0"
                          AutomationProperties.Name="Disabled"
                          ToolTip="Show endpoints disabled in Windows Sound settings">
                    <TextBlock>
                        <Run Text="Disabled"/>
                        <Run Text="{Binding DisabledDeviceCount, Mode=OneWay}" Foreground="{DynamicResource TextTertiary}"/>
                    </TextBlock>
                </CheckBox>
                <CheckBox IsChecked="{Binding ShowNotPresentDevices}" Style="{StaticResource FilterChip}" VerticalAlignment="Center"
                          AutomationProperties.Name="Not present"
                          ToolTip="Show endpoints whose hardware isn't connected (e.g. headsets that were used once)">
                    <TextBlock>
                        <Run Text="Not present"/>
                        <Run Text="{Binding NotPresentDeviceCount, Mode=OneWay}" Foreground="{DynamicResource TextTertiary}"/>
                    </TextBlock>
                </CheckBox>
            </StackPanel>
        </DockPanel>

        <!-- Device list on top, selected device's details below; drag the splitter between them to resize. -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="200"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SurfacePanel}" BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1" CornerRadius="6" Padding="0,0,0,2">
            <DataGrid x:Name="DeviceGrid"
                      ItemsSource="{Binding Devices}"
                      SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserResizeColumns="False"
                      CanUserReorderColumns="False"
                      CanUserSortColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      Background="Transparent"
                      RowBackground="Transparent"
                      BorderThickness="0"
                      RowHeight="48"
                      FontSize="{StaticResource FontBody}"
                      Foreground="{DynamicResource TextPrimary}"
                      ColumnHeaderStyle="{StaticResource ListHeader}"
                      CellStyle="{StaticResource ListCell}"
                      RowStyle="{StaticResource ListRow}"
                      HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.ScrollChanged="DeviceGrid_ScrollChanged"
                      VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                      TextOptions.TextRenderingMode="Grayscale">
                <!-- OUTPUTS / INPUTS sections, or one group per physical device (the "By device" chip); MainViewModel
                     sets the view's grouping. Clicking a group's heading collapses it. -->
                <DataGrid.GroupStyle>
                    <GroupStyle ContainerStyle="{StaticResource ListSection}"/>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <!-- Device-type icon, name and role pills, with a quiet state line underneath. -->
                    <DataGridTemplateColumn x:Name="DeviceColumn" Width="*" MinWidth="220">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="DEVICE" VerticalAlignment="Center"/>
                                <!-- Labelled with the grouping a click switches to. -->
                                <CheckBox IsChecked="{Binding DataContext.GroupByDevice, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          FontSize="{StaticResource FontCaption}" Padding="8,1,8,2" Margin="12,-3,0,-3"
                                          VerticalAlignment="Center" AutomationProperties.Name="Group by device">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox" BasedOn="{StaticResource SwitchChip}">
                                            <Setter Property="Content" Value="By device"/>
                                            <Setter Property="ToolTip" Value="Group the list by physical device (a headset's speaker and mic together; built-in audio under This PC) instead of outputs and inputs"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Content" Value="By input / output"/>
                                                    <Setter Property="ToolTip" Value="Group the list into outputs and inputs again"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding IconGlyph}" ToolTip="{Binding IconToolTip}" FontFamily="{StaticResource IconFont}"
                                               FontSize="{StaticResource IconLarge}" Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <!-- The pills are docked right but the panel is only as wide as its content, so they
                                             sit right after the name; a long name is trimmed before they are. -->
                                        <DockPanel HorizontalAlignment="Left">
                                            <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource RoleBadges}"/>
                                            <TextBlock Text="{Binding Device.FriendlyName}" ToolTip="{Binding Device.FriendlyName}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <!-- "Active", plus " · In use by <app>" (accent) while another app streams here. -->
                                        <TextBlock FontSize="{StaticResource FontCaption}" Margin="0,2,0,0" ToolTip="{Binding UsageToolTip}"
                                                   Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding DirectionPrefix, Mode=OneWay}"/><Run Text="{Binding StateText, Mode=OneWay}"/><Run Text="{Binding UsageSuffix, Mode=OneWay}" Foreground="{DynamicResource Accent}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="LEVEL" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ProgressBar Style="{StaticResource FlatMeter}" Minimum="0" Maximum="1"
                                             Value="{Binding MeterLevel, Mode=OneWay}" ToolTip="{Binding LevelText}"
                                             Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- UpdateSourceTrigger=PropertyChanged is required: inside a DataGrid, cell bindings join the row's
                         BindingGroup, which makes their default trigger Explicit (only on row edit commit), so
                         without it the slider/toggle never write back to the view model. -->
                    <DataGridTemplateColumn Header="VOLUME" Width="210">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Visibility="{Binding HasVolume, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" IsChecked="{Binding IsMuted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Width="28" Height="26" Margin="0,0,8,0">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton" BasedOn="{StaticResource FlatIconToggle}">
                                                <Setter Property="ToolTip" Value="Mute"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                        <Setter Property="ToolTip" Value="Unmute"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="{StaticResource IconNormal}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <!-- Output: speaker / speaker-muted. Input: mic / mic-off. -->
                                                    <Setter Property="Text" Value="&#xE720;"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOutput}" Value="True">
                                                            <Setter Property="Text" Value="&#xE767;"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsOutput}" Value="True"/>
                                                                <Condition Binding="{Binding IsMuted}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Text" Value="&#xE74F;"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Negative}"/>
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsOutput}" Value="False"/>
                                                                <Condition Binding="{Binding IsMuted}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Text" Value="&#xEC54;"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Negative}"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </ToggleButton>
                                    <Slider Grid.Column="1" Style="{StaticResource FlatSlider}" Minimum="0" Maximum="100"
                                            VerticalAlignment="Center"
                                            Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10"/>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontLabel}"
                                               Text="{Binding VolumePercent, StringFormat={}{0:0}%}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="TEST" Width="124">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="TestButton_Click" MinWidth="92" HorizontalAlignment="Left">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                            <Setter Property="ToolTip" Value="Start test"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTesting}" Value="True">
                                                    <Setter Property="ToolTip" Value="Stop test"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Test"/>
                                                    <Style.Triggers>
                                                        <!-- Input test, 2nd phase: the recording is being played back. -->
                                                        <DataTrigger Binding="{Binding IsPlayingBack}" Value="True">
                                                            <Setter Property="Text" Value="Playback"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource IconSmall}"
                                                   FontFamily="{StaticResource IconFont}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE768;"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Positive}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTesting}" Value="True">
                                                            <Setter Property="Text" Value="&#xE71A;"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource Negative}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            </Border>

            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                          Cursor="SizeNS" ToolTip="Drag to resize the device list / details"/>

            <!-- Details: header card, level graph and channel meters on the left; on the right the side panel: a row of
                 tabs and the open tab's panel. With no tab open only the tabs remain, next to the card, and the graph
                 gets the full width (see ApplySidePanelLayout in the code-behind). -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="320"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="SidePanelColumn" Width="3*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header card: icon, name and role pills; state and formats as chips; the endpoint ID behind a copy button. -->
                <Border Grid.Row="0" Grid.Column="0" Margin="0,0,0,8" Padding="12,10,8,6" CornerRadius="6" BorderThickness="1"
                        Background="{DynamicResource SurfacePanel}" BorderBrush="{DynamicResource BorderSubtle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="6" Margin="0,0,12,4" VerticalAlignment="Top"
                                Background="{DynamicResource SurfaceRaised}" ToolTip="{Binding SelectedDevice.IconToolTip}">
                            <TextBlock Text="{Binding SelectedDevice.IconGlyph}" FontFamily="{StaticResource IconFont}"
                                       FontSize="{StaticResource IconLarge}" Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding SelectedDevice.Device.FriendlyName}" ToolTip="{Binding SelectedDevice.Device.FriendlyName}"
                                       FontSize="{StaticResource FontTitle}" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                            <!-- MinHeight: the formats arrive a moment after the selection; the card shouldn't jump. -->
                            <WrapPanel MinHeight="24">
                                <!-- The pills bring an 8 px left margin (for the list); pulled back so they align with the name.
                                     A ContentControl, because a ContentPresenter's own data context is its content. -->
                                <ContentControl Content="{Binding SelectedDevice}" ContentTemplate="{StaticResource RoleBadges}"
                                                  Margin="-8,0,8,4" Focusable="False">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding SelectedDevice.Device.IsDefaultDevice, FallbackValue=False}" Value="False"/>
                                                        <Condition Binding="{Binding SelectedDevice.Device.IsDefaultCommunicationsDevice, FallbackValue=False}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDevice.IsActive, FallbackValue=True}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SelectedDevice.StateText}" Style="{StaticResource ChipText}" Foreground="{DynamicResource Caution}"/>
                                </Border>
                                <Border>
                                    <Border.ToolTip>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="Shared mode — the format every app sharing this device is converted to:"/><LineBreak/>
                                            <Run Text="{Binding SelectedDeviceDetails.SharedModeFormat, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border.ToolTip>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDeviceDetails.SharedModeFormat, FallbackValue={x:Null}}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Style="{StaticResource ChipText}">
                                        <Run Text="Shared" Foreground="{DynamicResource TextTertiary}"/>
                                        <Run Text="{Binding SelectedDeviceDetails.SharedModeFormat.ShortText, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                                <Border>
                                    <Border.ToolTip>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="Exclusive mode — the format an app that takes over the device would use:"/><LineBreak/>
                                            <Run Text="{Binding SelectedDeviceDetails.ExclusiveModeFormat, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border.ToolTip>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDeviceDetails.ExclusiveModeFormat, FallbackValue={x:Null}}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Style="{StaticResource ChipText}">
                                        <Run Text="Exclusive" Foreground="{DynamicResource TextTertiary}"/>
                                        <Run Text="{Binding SelectedDeviceDetails.ExclusiveModeFormat.ShortText, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                                <Border ToolTip="The driver says this microphone can be recorded without any processing (see Raw recording)">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDeviceDetails.RawProcessingSupported, FallbackValue={x:Null}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Raw" Style="{StaticResource ChipText}"/>
                                </Border>
                                <Button Click="CopyIdButton_Click" Style="{StaticResource FlatButton}" BorderThickness="0"
                                        Padding="8,2,8,3" Margin="0,0,6,4" AutomationProperties.Name="Copy endpoint ID">
                                    <Button.ToolTip>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="Copy the endpoint ID:"/><LineBreak/>
                                            <Run Text="{Binding SelectedDevice.Device.Id, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Button.ToolTip>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontCaption}"
                                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="ID" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="DetailsBody" Grid.Row="1" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="60"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,8" CornerRadius="6" BorderThickness="1"
                            Background="{DynamicResource SurfacePanel}" BorderBrush="{DynamicResource BorderSubtle}">
                        <local:LevelGraph x:Name="DetailGraph" Background="Transparent" Margin="1"/>
                    </Border>

                    <!-- Channel strip: per-channel meter + dB readout + play button; "Cycle all" plays each in turn. -->
                    <DockPanel Grid.Row="1"
                               Visibility="{Binding HasChannels, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel DockPanel.Dock="Left" Width="104" Margin="0,0,12,0" VerticalAlignment="Top">
                            <TextBlock Text="CHANNELS" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextTertiary}"/>
                            <Button Click="CycleChannelsButton_Click" Margin="0,8,0,0" Padding="8,4" HorizontalAlignment="Left"
                                    IsEnabled="{Binding CanCycleChannels}" ToolTip="{Binding CycleChannelsToolTip}"
                                    ToolTipService.ShowOnDisabled="True" Style="{StaticResource FlatButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Cycle all"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelectedDeviceTesting}" Value="True">
                                                        <Setter Property="Text" Value="Stop"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource IconSmall}"
                                               FontFamily="{StaticResource IconFont}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE768;"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Positive}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelectedDeviceTesting}" Value="True">
                                                        <Setter Property="Text" Value="&#xE71A;"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Negative}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding SelectedDeviceChannelPeaks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" Width="44" Margin="0,0,4,0">
                                        <!-- Channel name; accent-coloured while this channel is sounding. -->
                                        <TextBlock Text="{Binding ShortName}" ToolTip="{Binding LongName}" FontSize="{StaticResource FontCaption}"
                                                   HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ProgressBar Style="{StaticResource FlatMeterVertical}" Minimum="0" Maximum="1"
                                                     Value="{Binding MeterLevel, Mode=OneWay}" ToolTip="{Binding LevelText}"
                                                     Width="6" Height="48" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding DbShort}" ToolTip="{Binding LevelText}" FontSize="{StaticResource FontCaption}"
                                                   Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,4"/>
                                        <Button Click="ChannelPlayButton_Click" Width="30" Height="22" Padding="0"
                                                HorizontalAlignment="Center" Style="{StaticResource FlatButton}"
                                                IsEnabled="{Binding CanPlay}" ToolTip="{Binding PlayToolTip}"
                                                ToolTipService.ShowOnDisabled="True">
                                            <TextBlock FontSize="{StaticResource IconSmall}" FontFamily="{StaticResource IconFont}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE768;"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Positive}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                <Setter Property="Text" Value="&#xE71A;"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource Negative}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Grid>

                <GridSplitter x:Name="SidePanelSplitter" Grid.Column="1" Grid.RowSpan="2" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="Transparent" ResizeBehavior="PreviousAndNext" ShowsPreview="False"/>

                <DockPanel x:Name="SidePanelHost" Grid.Column="2" Grid.RowSpan="2">
                    <!-- Each tab opens its panel (closing any other); clicking the open one closes it. -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,6">
                        <ToggleButton IsChecked="{Binding IsPropertiesPanelOpen}" AutomationProperties.Name="Properties">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource PanelTab}">
                                    <Setter Property="ToolTip" Value="Show device properties"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPropertiesPanelOpen}" Value="True">
                                            <Setter Property="ToolTip" Value="Hide device properties"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource IconNormal}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock VerticalAlignment="Center"><Run Text="Properties"/></TextBlock>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding IsEventsPanelOpen}" AutomationProperties.Name="Events">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource PanelTab}">
                                    <Setter Property="ToolTip" Value="Show the event log"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEventsPanelOpen}" Value="True">
                                            <Setter Property="ToolTip" Value="Hide the event log"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource IconNormal}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock VerticalAlignment="Center"><Run Text="Events"/> <Run Text="{Binding EventLog.Events.Count, Mode=OneWay}" Foreground="{DynamicResource TextTertiary}"/></TextBlock>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding IsProcessesPanelOpen}" AutomationProperties.Name="Processes">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource PanelTab}">
                                    <Setter Property="ToolTip" Value="Show the processes (apps) using the selected device"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProcessesPanelOpen}" Value="True">
                                            <Setter Property="ToolTip" Value="Hide the processes panel"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource IconNormal}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock VerticalAlignment="Center"><Run Text="Processes"/></TextBlock>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding IsRecordingsPanelOpen}" AutomationProperties.Name="Raw recording"
                                      IsEnabled="{Binding CanOpenRecordingsPanel}" ToolTipService.ShowOnDisabled="True">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource PanelTab}">
                                    <Setter Property="ToolTip" Value="Show raw recording: record the selected mic raw and as call apps receive it, and compare"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecordingsPanelOpen}" Value="True">
                                            <Setter Property="ToolTip" Value="Hide the raw recording panel"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CanOpenRecordingsPanel}" Value="False">
                                            <Setter Property="ToolTip" Value="Raw recording is for microphones — select an input device"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource IconNormal}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock VerticalAlignment="Center"><Run Text="Raw recording"/></TextBlock>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding IsDriverPanelOpen}" AutomationProperties.Name="Driver">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource PanelTab}">
                                    <Setter Property="ToolTip" Value="Show the selected device's driver, USB connection and audio effects (APOs)"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDriverPanelOpen}" Value="True">
                                            <Setter Property="ToolTip" Value="Hide the driver panel"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE950;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource IconNormal}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock VerticalAlignment="Center"><Run Text="Driver"/></TextBlock>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                    <Grid>
                        <!-- PROPERTIES: the selected device's property store, in the same table style as the event log. -->
                        <Border x:Name="PropertiesPanel" Background="{DynamicResource SurfacePanel}"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="0,0,0,2">
                            <DataGrid x:Name="PropertiesGrid"
                                      ItemsSource="{Binding SelectedDeviceProperties}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      CanUserResizeColumns="True"
                                      CanUserReorderColumns="False"
                                      CanUserSortColumns="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      Background="Transparent"
                                      RowBackground="Transparent"
                                      BorderThickness="0"
                                      RowHeight="24"
                                      FontSize="{StaticResource FontLabel}"
                                      ClipboardCopyMode="None"
                                      Foreground="{DynamicResource TextPrimary}"
                                      ColumnHeaderStyle="{StaticResource LogHeaderResizable}"
                                      CellStyle="{StaticResource LogCell}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      TextOptions.TextRenderingMode="Grayscale">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Separator}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="PROPERTY" Width="260" MinWidth="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- Unknown keys show their raw UID, greyed so named ones stand out. The tooltip
                                                     gives the SDK symbol, or for undocumented keys how their meaning was confirmed. -->
                                                <TextBlock Text="{Binding Name}" ToolTip="{Binding NameToolTip}" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsKnown}" Value="False">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- Decoded values (formats, jack types, dates, …) show the raw value in their tooltip. -->
                                    <DataGridTemplateColumn Header="VALUE" Width="320" MinWidth="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Value}" ToolTip="{Binding ValueToolTip}" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="KEY" Width="330" MinWidth="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding KeyLabel, Mode=OneWay}"/>
                                                    <Run Text="{Binding RawKey, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Event timeline: shares the right-hand column with the property table (only one is open at a time). -->
                        <Border x:Name="EventsPanel" DataContext="{Binding EventLog}"
                                Background="{DynamicResource SurfacePanel}" BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1" CornerRadius="6">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="10,8,10,6">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="Copy" Click="CopyEventsButton_Click" Style="{StaticResource FlatButton}"
                                                    Padding="10,3" Margin="0,0,6,0" ToolTip="Copy the shown events as text"/>
                                            <Button Content="Export…" Click="ExportEventsButton_Click" Style="{StaticResource FlatButton}"
                                                    Padding="10,3" Margin="0,0,6,0" ToolTip="Save the shown events as CSV, Markdown or JSON Lines"/>
                                            <Button Content="Clear" Click="ClearEventsButton_Click" Style="{StaticResource FlatButton}"
                                                    Padding="10,3" ToolTip="Remove all recorded events"/>
                                        </StackPanel>
                                        <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontCaption}">
                                            <Run Text="{Binding CountText, Mode=OneWay}" Foreground="{DynamicResource TextSecondary}"/>
                                            <Run Text="shown" Foreground="{DynamicResource TextSecondary}"/>
                                        </TextBlock>
                                    </DockPanel>
                                    <WrapPanel Margin="0,8,0,0">
                                        <CheckBox Content="Devices" IsChecked="{Binding ShowDevices}" Style="{StaticResource FlatCheckBox}" Margin="0,0,14,4"
                                                  ToolTip="Endpoints added, removed, or changing state (active, unplugged, disabled, not present)"/>
                                        <CheckBox Content="Defaults" IsChecked="{Binding ShowDefaults}" Style="{StaticResource FlatCheckBox}" Margin="0,0,14,4"
                                                  ToolTip="Default and communications device changes"/>
                                        <CheckBox Content="Volume" IsChecked="{Binding ShowVolume}" Style="{StaticResource FlatCheckBox}" Margin="0,0,14,4"
                                                  ToolTip="Volume and mute changes (active devices)"/>
                                        <CheckBox Content="Tests" IsChecked="{Binding ShowTests}" Style="{StaticResource FlatCheckBox}" Margin="0,0,14,4"
                                                  ToolTip="Tests started and finished in this app"/>
                                        <CheckBox Content="Apps" IsChecked="{Binding ShowApps}" Style="{StaticResource FlatCheckBox}" Margin="0,0,14,4"
                                                  ToolTip="Other apps starting or stopping a stream on a device (checked twice a second)"/>
                                        <CheckBox Content="Properties" IsChecked="{Binding RecordPropertyChanges}" Style="{StaticResource FlatCheckBox}" Margin="0,0,14,4"
                                                  ToolTip="Record property-store changes too. Off by default: they are very frequent, so they're only recorded while this is ticked"/>
                                        <CheckBox Content="Selected device only" IsChecked="{Binding SelectedDeviceOnly}" Style="{StaticResource FlatCheckBox}" Margin="0,0,0,4"
                                                  ToolTip="Only show events for the device selected in the list (plus app start and errors)"/>
                                    </WrapPanel>
                                </StackPanel>

                                <DataGrid x:Name="EventsGrid"
                                          ItemsSource="{Binding View}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          CanUserReorderColumns="False"
                                          CanUserSortColumns="False"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="None"
                                          Background="Transparent"
                                          RowBackground="Transparent"
                                          BorderThickness="0"
                                          RowHeight="26"
                                          FontSize="{StaticResource FontLabel}"
                                          ClipboardCopyMode="None"
                                          Foreground="{DynamicResource TextPrimary}"
                                          ColumnHeaderStyle="{StaticResource LogHeader}"
                                          CellStyle="{StaticResource LogCell}"
                                          RowStyle="{StaticResource LogRow}"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          TextOptions.TextRenderingMode="Grayscale">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="TIME" Width="86">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource TextSecondary}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="EVENT" Width="76">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding KindText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Negative}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="DefaultChanged">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="DEVICE" Width="*" MinWidth="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DeviceText}" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="DETAIL" Width="2*" MinWidth="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="BY" Width="64">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SourceText}" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondary}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <!-- PROCESSES: apps (processes) with an audio session on the selected device — read-only (N1). -->
                        <Border x:Name="ProcessesPanel" Background="{DynamicResource SurfacePanel}"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6">
                            <DockPanel Margin="10,8,10,8">
                                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" FontSize="{StaticResource FontCaption}"
                                           Text="{Binding SessionsSummary}" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock DockPanel.Dock="Top" FontSize="{StaticResource FontLabel}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                           Text="Select an active device to see which apps have it open.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowSessions}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,4"
                                      Visibility="{Binding ShowSessions, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="74"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="APP" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextTertiary}"/>
                                    <TextBlock Grid.Column="1" Text="PROCESS · PID" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextTertiary}"/>
                                    <TextBlock Grid.Column="2" Text="STATE" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextTertiary}"/>
                                    <TextBlock Grid.Column="3" Text="VOLUME" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextTertiary}"
                                               ToolTip="App volume (Windows volume mixer)"/>
                                    <TextBlock Grid.Column="4" Text="LEVEL" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextTertiary}"/>
                                </Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{Binding ShowSessions, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl x:Name="SessionsList" ItemsSource="{Binding SelectedDeviceSessions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="26" ToolTip="{Binding ToolTip}" Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="74"/>
                                                        <ColumnDefinition Width="52"/>
                                                        <ColumnDefinition Width="80"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Opacity" Value="0.55"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <TextBlock Grid.Column="0" Text="{Binding AppName}" FontSize="{StaticResource FontLabel}" Foreground="{DynamicResource TextPrimary}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ProcessText}" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondary}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding StateText}" FontSize="{StaticResource FontCaption}" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="3" Text="{Binding VolumeText}" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondary}"
                                                               VerticalAlignment="Center" ToolTip="App volume (Windows volume mixer)"/>
                                                    <ProgressBar Grid.Column="4" Style="{StaticResource FlatMeter}" Minimum="0" Maximum="1"
                                                                 Value="{Binding MeterLevel, Mode=OneWay}" ToolTip="{Binding LevelText}"
                                                                 VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- RAW RECORDING (inputs, N4): the last recording per processing mode — Raw / Call / Standard — for A/B
                             listening. Record A/B records all three at once; picking a line makes the channel strip play it. -->
                        <Border x:Name="RecordingsPanel" Background="{DynamicResource SurfacePanel}"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6">
                            <DockPanel Margin="10,8,10,8">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Click="RecordAbButton_Click" Padding="10,3" Margin="8,0,0,0"
                                            Style="{StaticResource FlatButton}" ToolTip="{Binding RecordAbToolTip}"
                                            Visibility="{Binding ShowRecordings, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Record A/B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelectedDeviceTesting}" Value="True">
                                                                <Setter Property="Text" Value="Stop"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource IconSmall}"
                                                       FontFamily="{StaticResource IconFont}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE7C8;"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Negative}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelectedDeviceTesting}" Value="True">
                                                                <Setter Property="Text" Value="&#xE71A;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock FontSize="{StaticResource FontCaption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding RecordingsSummary}">
                                        <Run Text="{Binding RecordingsSummary, Mode=OneWay}" Foreground="{DynamicResource TextSecondary}"/>
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                           Margin="0,0,0,10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Record A/B records this mic three ways at the same time — Raw (no processing), Call (what Teams / Webex receive: what the other side of a call hears, before the app's own processing) and Standard (most apps) — then plays Raw and Call back to back. Pick a line to play its channels from the channel strip."/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowRecordings}" Value="False">
                                                    <Setter Property="Text" Value="Select an active microphone to record it raw and as call apps receive it."/>
                                                    <Setter Property="FontSize" Value="{StaticResource FontLabel}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- A ListBox (not an ItemsControl) so lines can be picked by keyboard / UI Automation too.
                                     Selecting a line only tells the view model; the highlight shows IsStripSource. -->
                                <ListBox x:Name="TakesList" ItemsSource="{Binding SelectedDeviceTakes}" SelectionChanged="TakesList_SelectionChanged"
                                         Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Top"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         Visibility="{Binding ShowRecordings, Converter={StaticResource BoolToVisibility}}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="AutomationProperties.HelpText" Value="{Binding ToolTip}"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="4,5,6,5" Margin="0,0,0,4" ToolTip="{Binding ToolTip}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasTake}" Value="True">
                                                                <Setter Property="Cursor" Value="Hand"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsStripSource}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource RowSelected}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34"/>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Button Grid.Column="0" Grid.RowSpan="2" Click="TakePlayButton_Click" Width="28" Height="22" Padding="0"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource FlatButton}"
                                                            IsEnabled="{Binding CanPlay}" ToolTip="{Binding PlayToolTip}"
                                                            ToolTipService.ShowOnDisabled="True">
                                                        <TextBlock FontSize="{StaticResource IconSmall}" FontFamily="{StaticResource IconFont}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="&#xE768;"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource Positive}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                            <Setter Property="Text" Value="&#xE71A;"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource Negative}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="{StaticResource FontBody}" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="2" Text="{Binding LevelText}" FontSize="{StaticResource FontLabel}" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimary}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding DetailText}" FontSize="{StaticResource FontCaption}" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,12,0"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding EffectsText}" FontSize="{StaticResource FontCaption}" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding Description}" FontSize="{StaticResource FontCaption}"
                                                               Margin="0,2,0,0" Foreground="{DynamicResource TextTertiary}" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- DRIVER: what is behind the endpoint: its audio device, driver, USB connection and the audio
                             effects (APOs) Windows runs on it (DeviceInventoryService). -->
                        <Border x:Name="DriverPanel" Background="{DynamicResource SurfacePanel}"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="10,8,10,2">
                                    <Button DockPanel.Dock="Right" Content="Copy" Click="CopyInventoryButton_Click" Padding="10,3"
                                            ToolTip="Copy these details as text (for a bug report)">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedDeviceInventory}" Value="{x:Null}">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontCaption}" Foreground="{DynamicResource TextSecondary}"
                                               Text="{Binding SelectedDeviceInventory.EndpointName, FallbackValue='Select a device.', TargetNullValue='Select a device.'}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,0,10,8">
                                    <ItemsControl x:Name="InventoryList" ItemsSource="{Binding SelectedDeviceInventory.Sections}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextTertiary}" Margin="0,0,0,4"/>
                                                    <ItemsControl ItemsSource="{Binding Rows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <!-- The tooltip has the details: CLSIDs, files, all hardware IDs. -->
                                                                <Grid Background="Transparent" ToolTip="{Binding ToolTip}" ToolTipService.ShowDuration="30000">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="150"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontLabel}" Foreground="{DynamicResource TextSecondary}"
                                                                               TextTrimming="CharacterEllipsis" Margin="0,2,8,2"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="{StaticResource FontLabel}"
                                                                               TextWrapping="Wrap" Margin="0,2">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Margin="0,8,0,0" Padding="8,6" CornerRadius="6" Background="{DynamicResource SurfacePanel}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextPrimary}"/>
        </Border>
    </Grid>
</Window>
