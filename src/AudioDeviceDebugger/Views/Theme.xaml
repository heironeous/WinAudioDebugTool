<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Flat dark theme for the whole app: no images, gradients or shadows, hairlines instead of gridlines, subtle
        hover/selection backgrounds, and minimal controls (thin meter, thin slider, flat buttons).
        Views use the names below instead of literal colours and sizes.
    -->

    <!-- Surfaces: three levels, each a bit lighter than the one it sits on. -->
    <SolidColorBrush x:Key="SurfaceBase" Color="#1C1C1F"/>   <!-- window, title bar -->
    <SolidColorBrush x:Key="SurfacePanel" Color="#252528"/>  <!-- device list, side panels, graph -->
    <SolidColorBrush x:Key="SurfaceRaised" Color="#323237"/> <!-- tooltips, hovered controls -->

    <!-- States. Pressed, track and outline are translucent, so they also show up on a selected row. -->
    <SolidColorBrush x:Key="RowHover" Color="#2B2B2F"/>
    <SolidColorBrush x:Key="RowSelected" Color="#2B3B4F"/>
    <SolidColorBrush x:Key="ControlPressed" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="ControlTrack" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="ControlOutline" Color="#30FFFFFF"/>

    <!-- Lines -->
    <SolidColorBrush x:Key="BorderSubtle" Color="#38383D"/>
    <SolidColorBrush x:Key="Separator" Color="#303034"/>

    <!-- Text: what you read, what supports it, and labels. -->
    <SolidColorBrush x:Key="TextPrimary" Color="#E8E8EA"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#A6A6AC"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#8F8F96"/>

    <!-- Meaning: accent (selection, roles), good / level, caution, bad / stop. -->
    <SolidColorBrush x:Key="Accent" Color="#5AB4F0"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#335AB4F0"/>
    <SolidColorBrush x:Key="Positive" Color="#4CC27B"/>
    <SolidColorBrush x:Key="Caution" Color="#E5B84B"/>
    <SolidColorBrush x:Key="Negative" Color="#E57373"/>

    <!-- Type scale: four text sizes, three icon sizes. -->
    <sys:Double x:Key="FontTitle">16</sys:Double>
    <sys:Double x:Key="FontBody">13</sys:Double>
    <sys:Double x:Key="FontLabel">12</sys:Double>
    <sys:Double x:Key="FontCaption">11</sys:Double>
    <sys:Double x:Key="IconLarge">20</sys:Double>
    <sys:Double x:Key="IconNormal">14</sys:Double>
    <sys:Double x:Key="IconSmall">10</sys:Double>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Column header: small, grey, uppercase labels (set in the column definitions) above a hairline. -->
    <Style x:Key="ListHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontCaption}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{StaticResource SurfacePanel}" BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="0,0,0,1" Padding="14,9">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Cell: padding, vertical centring, and the row's hover/selection background. The background is drawn here
        rather than on DataGridRow because the DataGrid coerces DataGridRow.Background to its RowBackground, which
        overrides style triggers. Foreground is pinned so the theme's "inactive selection" text colour (near-black)
        never applies.
    -->
    <Style x:Key="ListCell" TargetType="DataGridCell">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="Bd" Background="Transparent" Padding="14,0">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHover}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowSelected}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Row: hairline separator; inactive devices are dimmed. (Hover/selection colour: see ListCell.) -->
    <Style x:Key="ListRow" TargetType="DataGridRow">
        <Setter Property="BorderBrush" Value="{StaticResource Separator}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Section in the device list (OUTPUTS / INPUTS): a heading with the number of devices shown, then its rows. -->
    <Style x:Key="ListSection" TargetType="GroupItem">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupItem">
                    <StackPanel>
                        <Border Padding="14,12,14,6" BorderBrush="{StaticResource Separator}" BorderThickness="0,0,0,1">
                            <TextBlock FontSize="{StaticResource FontCaption}" FontWeight="SemiBold">
                                <Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource TextSecondary}"/>
                                <Run Text="{Binding ItemCount, Mode=OneWay}" Foreground="{StaticResource TextTertiary}" FontWeight="Normal"/>
                            </TextBlock>
                        </Border>
                        <ItemsPresenter/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact variants for dense tables (event log): same look as the device list, tighter padding. -->
    <Style x:Key="LogHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ListHeader}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{StaticResource SurfacePanel}" BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="0,0,0,1" Padding="8,7">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LogCell" TargetType="DataGridCell">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="Bd" Background="Transparent" Padding="8,0">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHover}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowSelected}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LogRow" TargetType="DataGridRow">
        <Setter Property="BorderBrush" Value="{StaticResource Separator}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ToolTip" Value="{Binding ToolTipText}"/>
    </Style>

    <!-- Level meter: a thin rounded line. PART_Indicator's width is driven by the ProgressBar. -->
    <Style x:Key="FlatMeter" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource Positive}"/>
        <Setter Property="Height" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="2" Background="{StaticResource ControlTrack}"/>
                        <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider: thin track, accent fill up to a small round handle. -->
    <Style x:Key="SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                        <Border Height="3" CornerRadius="1.5" VerticalAlignment="Center" Background="{StaticResource Accent}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderRemainder" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderHandle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse x:Name="Handle" Width="12" Height="12" Fill="{StaticResource TextPrimary}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Handle" Property="Fill" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FlatSlider" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="18" Background="Transparent">
                        <Border Height="3" CornerRadius="1.5" VerticalAlignment="Center" Background="{StaticResource ControlTrack}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRemainder}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderHandle}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small pill: a device's role (Default, Comms). -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8,1,8,2"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontCaption}"/>
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
    </Style>

    <!-- Neutral chip: a fact about the device (format, state). -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,2,8,3"/>
        <Setter Property="Margin" Value="0,0,6,4"/>
        <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
    </Style>
    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontCaption}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <!-- Outlined flat button (Test). -->
    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlOutline}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceRaised}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Checkbox: rounded square outline; filled with the accent and a check glyph when ticked. -->
    <Style x:Key="FlatCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="3" BorderThickness="1.5"
                                BorderBrush="{StaticResource TextTertiary}" Background="Transparent" VerticalAlignment="Center">
                            <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                       FontSize="{StaticResource IconSmall}" Foreground="{StaticResource SurfacePanel}" Visibility="Collapsed"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter chip: a checkbox drawn as a rounded toggle (accent when on). -->
    <Style x:Key="FilterChip" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlOutline}"/>
        <Setter Property="Padding" Value="12,4,12,5"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Bd" CornerRadius="13" Background="{TemplateBinding Background}" BorderThickness="1"
                            BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceRaised}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <!-- Keyboard focus (there is no dotted focus rectangle). -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vertical meter (per-channel bars): the horizontal flat meter rotated, so ProgressBar's indicator sizing
         (which always sets PART_Indicator.Width) fills bottom-up. -->
    <Style x:Key="FlatMeterVertical" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource Positive}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Grid.LayoutTransform>
                            <RotateTransform Angle="-90"/>
                        </Grid.LayoutTransform>
                        <Border x:Name="PART_Track" CornerRadius="3" Background="{StaticResource ControlTrack}"/>
                        <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tall strip toggle at a panel edge (Properties): flat panel matching the list border, subtle text. -->
    <Style x:Key="FlatStripToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Background" Value="{StaticResource SurfacePanel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceRaised}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowSelected}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Scrollbars (every ScrollBar in the app): a thin rounded thumb on a transparent track, no arrow buttons. -->
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Border x:Name="Bar" CornerRadius="3" Margin="2" Background="{StaticResource ControlOutline}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource TextTertiary}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource TextTertiary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumbStyle}" MinHeight="24"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPage}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPage}"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumbStyle}" MinWidth="24"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Tooltips (all of them): flat dark box; long text wraps. -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="MaxWidth" Value="520"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" Padding="10,6">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact header whose columns can be resized by dragging the right edge (property table). -->
    <Style x:Key="HeaderGripper" TargetType="Thumb">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Border Width="1" Margin="0,6" HorizontalAlignment="Right" Background="{StaticResource BorderSubtle}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LogHeaderResizable" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ListHeader}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border Background="{StaticResource SurfacePanel}" BorderBrush="{StaticResource BorderSubtle}"
                                BorderThickness="0,0,0,1" Padding="8,7">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource HeaderGripper}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless icon toggle (mute). -->
    <Style x:Key="FlatIconToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceRaised}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
