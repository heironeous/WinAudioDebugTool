<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Light palette: the same keys as Dark.xaml (see there). Text colours keep at least 4.5:1 contrast on every
        surface (WCAG AA), and the meaning colours are darker than in the dark palette so they stay readable on white;
        a unit test checks both.
    -->

    <!-- Surfaces: the window is a light grey, panels white, raised elements a touch darker than the panel. -->
    <SolidColorBrush x:Key="SurfaceBase" Color="#EFEFF2"/>
    <SolidColorBrush x:Key="SurfacePanel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="#F0F0F3"/>

    <!-- States -->
    <SolidColorBrush x:Key="RowHover" Color="#F4F4F7"/>
    <SolidColorBrush x:Key="RowSelected" Color="#DDEBF8"/>
    <SolidColorBrush x:Key="RowSelectedBorder" Color="Transparent"/>
    <SolidColorBrush x:Key="ControlPressed" Color="#24000000"/>
    <SolidColorBrush x:Key="ControlTrack" Color="#1C000000"/>
    <SolidColorBrush x:Key="ControlOutline" Color="#38000000"/>

    <!-- Device rows by state (see Dark.xaml). The unplugged tint is a clear yellow rather than the brownish Caution. -->
    <SolidColorBrush x:Key="RowMutedBorder" Color="#80C42B1C"/>
    <SolidColorBrush x:Key="RowDisabledBorder" Color="#C42B1C"/>
    <SolidColorBrush x:Key="RowDisabledTint" Color="#30C42B1C"/>
    <SolidColorBrush x:Key="RowUnpluggedTint" Color="#40F2C230"/>

    <!-- Lines -->
    <SolidColorBrush x:Key="BorderSubtle" Color="#D9D9DE"/>
    <SolidColorBrush x:Key="Separator" Color="#E7E7EB"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#1B1B1F"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#55555E"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#62626B"/>

    <!-- Meaning -->
    <SolidColorBrush x:Key="Accent" Color="#0F6CBD"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#260F6CBD"/>
    <SolidColorBrush x:Key="Positive" Color="#107C41"/>
    <SolidColorBrush x:Key="Caution" Color="#8A5300"/>
    <SolidColorBrush x:Key="Negative" Color="#C42B1C"/>

    <SolidColorBrush x:Key="GraphPlate" Color="#D9FFFFFF"/>
</ResourceDictionary>
