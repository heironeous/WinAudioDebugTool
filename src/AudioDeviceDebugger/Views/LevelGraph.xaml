<UserControl x:Class="AudioDeviceDebugger.Views.LevelGraph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="16" MinWidth="40" Background="{DynamicResource SurfacePanel}">
    <Grid ClipToBounds="True">
        <!-- Zone tints, dB gridlines and labels, drawn in code-behind on resize. -->
        <Canvas x:Name="GridCanvas" IsHitTestVisible="False"/>
        <!-- The trace: filled area + line, both coloured by level. Shifted sideways between samples (smooth scrolling). -->
        <Canvas IsHitTestVisible="False">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="Scroll"/>
            </Canvas.RenderTransform>
            <Polygon x:Name="GraphFill"/>
            <Polyline x:Name="GraphLine" StrokeThickness="1.5" StrokeLineJoin="Round"/>
        </Canvas>
        <!-- Peak hold: the recent maximum, held for a moment before it falls. -->
        <Line x:Name="PeakLine" StrokeThickness="1" Opacity="0.7" StrokeDashArray="2 3" Visibility="Collapsed"/>
        <!-- Readouts, on a plate so a loud trace doesn't run through the text. -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Padding="6,2,6,3" CornerRadius="4"
                Background="{DynamicResource GraphPlate}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="PeakReadout" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontLabel}" FontFamily="Consolas"
                           Margin="0,0,12,0" ToolTip="Peak hold: the recent maximum"/>
                <TextBlock x:Name="LevelReadout" Foreground="{DynamicResource Positive}" FontSize="{StaticResource FontLabel}" FontFamily="Consolas"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
