<UserControl x:Class="AudioDeviceDebugger.Views.LevelGraph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="16" MinWidth="40" Background="{StaticResource SurfacePanel}">
    <Grid ClipToBounds="True">
        <!-- dB gridlines + labels, drawn in code-behind on resize. -->
        <Canvas x:Name="GridCanvas" IsHitTestVisible="False"/>
        <Polyline x:Name="GraphLine" Stroke="{StaticResource Positive}" StrokeThickness="1.25" />
        <TextBlock x:Name="LevelReadout" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0"
                   Foreground="{StaticResource Positive}" FontSize="{StaticResource FontLabel}" FontFamily="Consolas"/>
    </Grid>
</UserControl>
